{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "kitty-direct",
        "source": "/home/lmz/.config/ags/assets/ornaments/valknut.png",
        "width": 24,
        "height": 11,
        "preserveAspectRatio": true,
        "padding": {
            "top": 1,
